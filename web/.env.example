# Copy to .env.local for local development.
# Authentication, Supabase, multiplayer, profiles, and cloud sync are deferred for this release.

# Sentry error monitoring (get DSN from Sentry project settings → Client Keys)
# NEXT_PUBLIC_SENTRY_DSN must be set at BUILD time: the CSP connect-src allowance
# is derived from it and baked into the build. Without it, the browser blocks Sentry.
# Redeploy after changing this value so the generated CSP is updated.
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o123.ingest.us.sentry.io/456
SENTRY_DSN=https://your-dsn@o123.ingest.us.sentry.io/456
